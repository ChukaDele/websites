---
import "../styles/fonts.css";
// Custom Bredge classes remain from production; the generated bridge strips
// only Tailwind import syntax for this static pilot's Vite processor.
import "../styles/bridge-globals.css";
import "../../../bredge/app/pages.css";
import "../../../bredge/app/qa-fixes.css";
import "../../../bredge/app/mobile-native.css";
import "../../../bredge/app/conversion.css";
import "../../../bredge/app/research.css";
import "../../../bredge/app/typography-rag.css";

interface Props { title?: string; description?: string; canonicalPath?: string; }
const title=Astro.props.title ?? "The Bredge | Data Engineering, Analytics & BI Partner";
const description=Astro.props.description ?? "Data engineering, analytics and business intelligence for growing companies. We reconcile your numbers and build reporting your team can trust.";
const canonical = new URL(Astro.props.canonicalPath ?? "/", "https://thebredge.com").toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#142321" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-bredge-v3.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="The Bredge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://thebredge.com/og.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
